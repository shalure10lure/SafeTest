# ---------------------------------------------------------------------------
# Módulo de IA (SafeTest)
# Copia este archivo a .env y ajusta los valores. No incluyas credenciales
# reales en archivos versionados.
# ---------------------------------------------------------------------------

# Proveedor activo: gemini para uso real; fake solo para pruebas o selección
# explícita. La aplicación no cambia de proveedor automáticamente.
IA_PROVIDER=gemini

# Gemini (obligatorio cuando IA_PROVIDER=gemini)
# GEMINI_MODEL debe ser un identificador real de modelo con generación de
# contenido y salida estructurada; verifícalo antes de configurarlo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_OUTPUT_TOKENS=8192

# Límites de la generación
IA_MAX_MATERIALES=3
IA_MAX_CARACTERES_TOTALES=60000
IA_MAX_CONCURRENTES=2

# Cada cuánto revisa el worker si hay generaciones pendientes (milisegundos).
IA_WORKER_INTERVALO_MS=2000

# ---------------------------------------------------------------------------
# Materiales académicos
# ---------------------------------------------------------------------------

# Tamaño máximo por archivo, en bytes (por defecto 10 MiB).
MATERIAL_MAX_BYTES=10485760

# Directorio de los archivos originales. Nunca se sirve por HTTP y debe quedar
# fuera de src/, dist/ y de cualquier carpeta estática.
MATERIAL_STORAGE_DIR=storage/materiales
